@model LibraryManagementSystem.Models.ReturnBookViewModel
@{
    ViewData["Title"] = "Return Book";
}

<h2>Return Book</h2>

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">@Model.BookTitleName</h5>
        <p class="card-text mb-1"><strong>Author:</strong> @Model.AuthorName</p>
        <p class="card-text"><strong>Due Date:</strong> @Model.DueDate.ToString("yyyy-MM-dd")</p>
    </div>
</div>

<form asp-action="Return" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="CheckoutID" />

    <div class="mb-3">
        <label asp-for="ConditionID" class="form-label">Condition on Return</label>
        <select asp-for="ConditionID" class="form-select">
            @foreach (var c in Model.Conditions)
            {
                if (Model.ConditionID == c.Id)
                {
                    <option value="@c.Id" selected>@c.Name</option>
                }
                else
                {
                    <option value="@c.Id">@c.Name</option>
                }
            }
        </select>
        <div class="form-text">Select "Poor" if the book was damaged during checkout.</div>
    </div>

    <button type="submit" class="btn btn-primary">Confirm Return</button>
    <a asp-action="MyCheckouts" class="btn btn-outline-secondary">Cancel</a>
</form>