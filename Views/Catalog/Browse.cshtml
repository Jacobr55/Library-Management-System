@model LibraryManagementSystem.Models.BrowseBooksPageViewModel
@{
    ViewData["Title"] = "Browse Books";
}

<h2>Browse Books</h2>

<p>
    <a asp-action="Popular" class="btn btn-outline-primary"> Popular Books This Month</a>
</p>

<form asp-action="Browse" method="get" class="mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-4">
            <label class="form-label">Search</label>
            <input type="text" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Title contains..." />
        </div>

        <div class="col-md-3">
            <label class="form-label">Genre</label>
            <select name="genreId" class="form-select">
                <option value="">All genres</option>
                @foreach (var g in Model.Genres)
                {
                    if (Model.SelectedGenreId == g.Id)
                    {
                        <option value="@g.Id" selected>@g.Name</option>
                    }
                    else
                    {
                        <option value="@g.Id">@g.Name</option>
                    }
                }
            </select>
        </div>

        <div class="col-md-3">
            <label class="form-label">Author</label>
            <select name="authorId" class="form-select">
                <option value="">All authors</option>
                @foreach (var a in Model.Authors)
                {
                    if (Model.SelectedAuthorId == a.Id)
                    {
                        <option value="@a.Id" selected>@a.Name</option>
                    }
                    else
                    {
                        <option value="@a.Id">@a.Name</option>
                    }
                }
            </select>
        </div>

        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Filter</button>
        </div>
    </div>
</form>

@if (!Model.Books.Any())
{
    <p class="text-muted">No books match your search.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Title</th>
                <th>Author</th>
                <th>Genre</th>
                <th>ISBN</th>
                <th>Available</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in Model.Books)
            {
                <tr>
                    <td>@book.BookTitleName</td>
                    <td>@book.AuthorName</td>
                    <td>@book.GenreName</td>
                    <td>@book.ISBN</td>
                    <td>@book.AvailableCopies</td>
                    <td>
                        @if (book.AvailableCopies == 0)
                        {
                            <button class="btn btn-secondary btn-sm" disabled>Unavailable</button>
                        }
                        else if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <form asp-action="Checkout" method="post" style="display:inline;">
                                <input type="hidden" name="bookTitleId" value="@book.BookTitleID" />
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-primary btn-sm">Checkout</button>
                            </form>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary btn-sm">Sign up to checkout</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}