@model List<LibraryManagementSystem.Models.BookCopy>
@{
    ViewData["Title"] = "Book Copies";
}

<h2>Book Copies</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Copy ID</th>
            <th>Title</th>
            <th>Purchased</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var copy in Model)
        {
            <tr class="@(copy.RetiredDate != null ? "table-secondary" : "")">
                <td>#@copy.BookCopyID</td>
                <td>@copy.BookTitleName</td>
                <td>@copy.PurchasedDate</td>
                <td>
                    @if (copy.RetiredDate != null)
                    {
                        <span class="badge bg-secondary">Retired @copy.RetiredDate</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Active</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>