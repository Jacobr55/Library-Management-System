@model List<LibraryManagementSystem.Models.BookCopy>
@{
    ViewData["Title"] = "Book Copies";
}

<h2>Book Copies</h2>

<a asp-controller="BookCopies" asp-action="Create" class="btn btn-primary mb-3">+ Add Book Copy</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Copy ID</th>
            <th>Title</th>
            <th>Purchased</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var copy in Model)
        {
            <tr class="@(copy.RetiredDate != null ? "table-secondary" : "")">
                <td>#@copy.BookCopyID</td>
                <td>@copy.BookTitleName</td>
                <td>@copy.PurchasedDate</td>
                <td>
                    @if (copy.RetiredDate != null)
                    {
                        <span class="badge bg-secondary">Retired @copy.RetiredDate</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Active</span>
                    }
                </td>
                <td>
                    @if (copy.RetiredDate != null)
                    {
                        <form asp-action="Reactivate" asp-route-id="@copy.BookCopyID" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-success">Reactivate</button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="Retire" asp-route-id="@copy.BookCopyID" method="post" class="d-inline"
                              onsubmit="return confirm('Retire this copy? It will be marked retired as of today.');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Retire</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>