@model List<LibraryManagementSystem.Models.BookTitle>
@{
    ViewData["Title"] = "Books";
}

<h2>Books</h2>

<a asp-controller="Books" asp-action="Create" class="btn btn-primary mb-3">+ Add Book</a>
<a asp-controller="Books" asp-action="InventoryStatus" class="btn btn-outline-info mb-3">Inventory Status</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Title</th>
            <th>Author</th>
            <th>Genre</th>
            <th>ISBN</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var book in Model)
        {
            <tr>
                <td>@book.BookTitleName</td>
                <td>@book.AuthorName</td>
                <td>@book.GenreName</td>
                <td>@book.ISBN</td>
                <td><a asp-action="Edit" asp-route-id="@book.BookTitleID" class="btn btn-sm btn-outline-primary">Edit</a></td>
            </tr>
        }
    </tbody>
</table>