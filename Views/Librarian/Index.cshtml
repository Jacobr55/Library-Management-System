@{
    ViewData["Title"] = "Librarian Access";
}

<div class="mt-4">
    <h2>Librarian Access</h2>
    <p class="text-muted">Direct access to database tables. Use these views to add, edit, or review records.</p>

    <div class="row g-3 mt-2">
        <div class="col-md-6 col-lg-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Books</h5>
                    <p class="card-text">Manage book titles, authors, genres, and ISBNs.</p>
                    <a asp-controller="Books" asp-action="Index" class="btn btn-primary">Open</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Authors</h5>
                    <p class="card-text">Manage author records and biographies.</p>
                    <a asp-controller="Authors" asp-action="Index" class="btn btn-primary">Open</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Book Copies</h5>
                    <p class="card-text">Manage individual physical copies of books, including purchase and retirement dates.</p>
                    <a asp-controller="BookCopies" asp-action="Index" class="btn btn-primary">Open</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Members</h5>
                    <p class="card-text">Manage library member accounts.</p>
                    <a asp-controller="Members" asp-action="Index" class="btn btn-primary">Open</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Checkouts</h5>
                    <p class="card-text">View and manage all checkout records.</p>
                    <a asp-controller="Checkouts" asp-action="Index" class="btn btn-primary">Open</a>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Back to Home</a>
    </div>
</div>