@model List<LibraryManagementSystem.Models.Member>
@{
    ViewData["Title"] = "Inactive Members";
}

<h2>Inactive Members</h2>
<p class="text-muted">
    Members who have not checked out a book in the last
    <strong>@ViewBag.InactiveDays days</strong>.
</p>

<form method="get" class="d-flex align-items-end gap-3 mb-4" style="max-width: 400px;">
    <div class="flex-grow-1">
        <label class="form-label">Days Since Last Checkout</label>
        <input type="number" name="inactiveDays" value="@ViewBag.InactiveDays"
               class="form-control" min="1" />
    </div>
    <button type="submit" class="btn btn-primary">Search</button>
</form>

@if (!Model.Any())
{
    <div class="alert alert-success">
        No inactive members found for this time range!
    </div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Member ID</th>
                <th>Email</th>
                <th>Last Checkout Date</th>
                <th>Days Inactive</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in Model)
            {
                <tr>
                    <td>@m.MemberID</td>
                    <td>@m.Email</td>
                    <td>
                        @if (m.LastCheckoutDate == null)
                        {
                            <span class="badge bg-secondary">Never checked out</span>
                        }
                        else
                        {
                            @m.LastCheckoutDate
                        }
                    </td>
                    <td>
                        @if (m.LastCheckoutDate == null)
                        {
                            <span class="text-muted">N/A</span>
                        }
                        else
                        {
                            int daysInactive = (DateOnly.FromDateTime(DateTime.Today)
                            .DayNumber - m.LastCheckoutDate.Value.DayNumber);
                            <span class="badge bg-warning text-dark">@daysInactive days</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<a asp-action="Index" class="btn btn-secondary mt-2">← Back to Members</a>