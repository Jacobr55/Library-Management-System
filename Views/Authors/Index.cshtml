@model List<LibraryManagementSystem.Models.Author>
@{
    ViewData["Title"] = "Authors";
}

<h2>Authors</h2>
<a asp-controller="Authors" asp-action="Create" class="btn btn-primary mb-3">+ Add Author</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Bio</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var a in Model)
        {
            <tr>
                <td>@a.FullName</td>
                <td>@(a.Bio?.Length > 80 ? a.Bio[..80] + "…" : a.Bio)</td>
            </tr>
        }
    </tbody>
</table>